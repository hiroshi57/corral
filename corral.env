rem ============================================================
rem  Corral 本番モード設定（このファイルを編集すれば設定変更できます）
rem  ※ start-corral.cmd がこの内容を読み込みます
rem ============================================================

rem 本番モード（実エージェントが実際に動く）。1 にするとデモ（疑似実行）になります
set CORRAL_DEMO=0

rem 対象リポジトリ（エージェントが作業する Git リポジトリ）
set CORRAL_REPO=C:\Users\hiroshi_takizawa\corral

rem 同時に実行するエージェントの上限（超過分はキュー待ち）
set CORRAL_MAX_CONCURRENT=3

rem ポリシーガードレール（危険コマンド遮断・機密マスキング）1=有効
set CORRAL_GUARDRAILS=1

rem 予算上限(USD)。0=無制限。到達で警告、ハードキャップ有効時は起動停止
set CORRAL_BUDGET_USD=0
set CORRAL_BUDGET_HARDCAP=0

rem ---- 通知（任意）: Chatwork / Slack ----
rem set CORRAL_CHATWORK_TOKEN=xxxxxxxx
rem set CORRAL_CHATWORK_ROOM=123456789
rem set CORRAL_SLACK_WEBHOOK=https://hooks.slack.com/services/xxx

rem ---- 実行モード（任意）: local / docker(サンドボックス) / ssh(リモート) ----
rem set CORRAL_EXEC_MODE=local
